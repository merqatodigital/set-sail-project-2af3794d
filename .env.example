# =============================================================================
# Partner Dashboard — environment variables
# =============================================================================
# Copy to `.env` (which is gitignored) and fill in what you have.
#
# The dashboard decides its backend at runtime, in this order:
#   1. Supabase, when SUPABASE_URL + a key are set AND a test query succeeds
#   2. Neon, when NEON_DATABASE_URL is set
#   3. Otherwise: localStorage-only mode (the UI still works; it shows
#      "offline — changes saved locally" and replays writes once a backend
#      becomes reachable)
#
# Whichever backend is active is logged to the deploy logs on boot, e.g.
#   [partner-dashboard] active backend: supabase (service key)
# =============================================================================

# ---------------------------------------------------------------------------
# Supabase (primary)
# ---------------------------------------------------------------------------
# SUPABASE_URL is the project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=

# Public "anon" / publishable key. Safe to expose — used as a fallback for
# writes when no service key is present.
SUPABASE_ANON_KEY=

# RECOMMENDED. The service_role key. Server-only — never expose this to the
# browser and never give it a VITE_ prefix.
#
# With it set:
#   • uploads go straight to the "comment-images" Storage bucket from the
#     server (no bucket write policy needed)
#   • the passcode gate in /api is the only way to write anything
# Without it, the dashboard still writes, but using the public key (see the
# SECURITY NOTE at the top of the partner-dashboard migration).
SUPABASE_SERVICE_KEY=

# The client bundle reads these two (already present in this repo's .env).
# Set them to the same values as SUPABASE_URL / SUPABASE_ANON_KEY.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Neon (fallback database)
# ---------------------------------------------------------------------------
# Only consulted when Supabase is missing or its test query fails.
# Neon is database-only, so images need BLOB_READ_WRITE_TOKEN (below).
NEON_DATABASE_URL=

# ---------------------------------------------------------------------------
# Image storage fallback (used with the Neon backend, or if Supabase Storage
# is unavailable). When this is unset, images under 500 KB are inlined as
# base64 data URLs with a console warning; larger ones are rejected.
# ---------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Dashboard gate
# ---------------------------------------------------------------------------
# Shared passcode required by every write endpoint (POST/PATCH/DELETE).
# Read endpoints stay public.
#
# If this is unset the server falls back to the built-in default "5309" and
# logs a warning. Set it to change the code — and prefer something longer than
# four digits if the dashboard ever holds anything sensitive.
DASHBOARD_PASSCODE=
